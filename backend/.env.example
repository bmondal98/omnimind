# Local development: copy this file to backend/.env and set the key there.
# Deployment (Render/Railway): set these same names as environment variables instead;
# real environment variables take priority over backend/.env.
# Never put the key in frontend env files.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
CORS_ORIGINS=*
